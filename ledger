                <ArrowRight className="mr-2 text-slate-600" />
                {selectedPerson === 'All' ? 'Payment Plan' : `Payments for ${selectedPerson}`}
              </h2>
              {filteredSettlements.length === 0 ? (
                <div className="text-center p-12 bg-slate-50 rounded-xl border-2 border-dashed border-slate-200 text-slate-500 font-medium">No pending payments found for this selection.</div>
              ) : (
                <div className="space-y-4">
                  {filteredSettlements.map((s, i) => (
                    <div key={i} className="bg-white rounded-xl shadow-md border-l-8 border-l-green-500 overflow-hidden transform transition hover:-translate-y-1 break-inside-avoid">
                      <div className="p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div className="flex flex-col items-center sm:items-start text-center sm:text-left">
                          <span className="text-sm text-slate-400 font-medium uppercase tracking-wider mb-1">Payer</span>
                          <div className={`px-4 py-2 rounded-lg font-bold text-lg ${s.from.theme.cellBg} ${s.from.theme.cellText}`}>{s.from.name}</div>
                        </div>
                        <div className="flex flex-col items-center px-4">
                          <span className="text-sm font-bold text-slate-400 mb-1">PAYS</span>
                          <ArrowRight className="text-slate-300 w-8 h-8" />
                        </div>
                        <div className="flex flex-col items-center sm:items-start text-center sm:text-left">
                          <span className="text-sm text-slate-400 font-medium uppercase tracking-wider mb-1">Receiver</span>
                          <div className={`px-4 py-2 rounded-lg font-bold text-lg ${s.to.theme.cellBg} ${s.to.theme.cellText}`}>{s.to.name}</div>
                        </div>
                        <div className="mt-4 sm:mt-0 sm:ml-auto text-center sm:text-right border-t sm:border-t-0 border-slate-100 pt-4 sm:pt-0 w-full sm:w-auto">
                          <span className="text-sm text-slate-400 font-medium uppercase tracking-wider block mb-1">Amount</span>
                          <span className="text-3xl font-extrabold text-slate-800">${s.amount.toFixed(2)}</span>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default App;
