// --- Helper Functions ---

const formatDescription = (text) => {
  if (!text) return '';
  let clean = text.replace(/"/g, '').replace(/\s+/g, ' ').trim();
  clean = clean.toLowerCase();
  clean = clean.replace(/\b\w/g, (char) => char.toUpperCase());
  clean = clean.replace(/\(\s+/g, '(').replace(/\s+\)/g, ')');
  return clean;
};

const refineCategory = (rawCat, rawDesc) => {
  const cat = (rawCat || '').toLowerCase();
  const desc = (rawDesc || '').toLowerCase();
  if (desc.includes('didi')) return 'Didi';
  if (cat === 'furniture' || cat === 'food' || desc.includes('food')) return 'Dining Out';
  if (cat === 'general') return 'Tickets';
  if (!rawCat) return 'Uncategorized';
  return rawCat.charAt(0).toUpperCase() + rawCat.slice(1);
};

const parseCSV = (text) => {
  const lines = text.trim().split('\n');
  if (lines.length < 2) return null;

  const parseLine = (line) => {
    const matches = [];
    let inQuote = false;
    let current = '';
    for (let i = 0; i < line.length; i++) {
      const char = line[i];
      if (char === '"') inQuote = !inQuote;
      else if (char === ',' && !inQuote) {
        matches.push(current.trim());
        current = '';
      } else current += char;
    }
    matches.push(current.trim());
    return matches;
  };

  const headers = parseLine(lines[0]);
  const costIndex = headers.findIndex(h => h.toLowerCase().includes('cost'));
  const currencyIndex = headers.findIndex(h => h.toLowerCase().includes('currency'));
  const categoryIndex = headers.findIndex(h => h.toLowerCase().includes('category'));
  const dateIndex = headers.findIndex(h => h.toLowerCase().includes('date'));
  const descIndex = headers.findIndex(h => h.toLowerCase().includes('description'));
  const firstPersonIndex = currencyIndex + 1; 
  
  const people = headers.slice(firstPersonIndex).map((name, idx) => ({
    name: name.replace(/"/g, ''),
    index: idx + firstPersonIndex,
    theme: COLUMN_THEMES[idx % COLUMN_THEMES.length]
  }));

  const rows = lines.slice(1).map((line, idx) => {
    const cols = parseLine(line);
    if (cols.length < headers.length) return null;
    
    const dateVal = cols[dateIndex] ? cols[dateIndex].toLowerCase() : '';
    const descVal = cols[descIndex] ? cols[descIndex].toLowerCase() : '';
    if (dateVal.includes('total') || descVal.includes('total balance')) return null;

    const formattedDesc = formatDescription(cols[descIndex]);
    const rawCat = cols[categoryIndex] || 'General';
    const finalCategory = refineCategory(rawCat, formattedDesc);

    const rowData = {
      id: idx,
      date: cols[dateIndex],
      description: formattedDesc,
      category: finalCategory,
      cost: parseFloat(cols[costIndex]) || 0,
      currency: cols[currencyIndex] || 'SGD',
      amounts: {}
    };

    people.forEach(p => {
      rowData.amounts[p.name] = parseFloat(cols[p.index]) || 0;
    });

    return rowData;
  }).filter(r => r); 

  return { rows, people };
};

// --- OPTIMIZED SETTLEMENT ALGORITHM ---
const calculateSettlements = (people, rows) => {
  const balances = {};
  people.forEach(p => balances[p.name] = 0);
  rows.forEach(row => {
    people.forEach(p => {
      balances[p.name] += row.amounts[p.name] || 0;
    });
  });

  let debtors = [];
  let creditors = [];

  Object.entries(balances).forEach(([name, amount]) => {
    const person = people.find(p => p.name === name);
    const roundedAmount = Math.round(amount * 100) / 100;
    
    if (roundedAmount < -0.01) debtors.push({ ...person, amount: roundedAmount });
    else if (roundedAmount > 0.01) creditors.push({ ...person, amount: roundedAmount });
  });

  const settlements = [];

  const addSettlement = (debtor, creditor, amount) => {
    settlements.push({ from: debtor, to: creditor, amount: amount });
    debtor.amount += amount;
    creditor.amount -= amount;
  };

  // 1. RECURSIVE SUBSET SUM (Largest Matches First)
  const findSubset = (target, pool, path = [], index = 0) => {
    if (Math.abs(target) < 0.02) return path;
    if (target < -0.01 || index >= pool.length) return null;

    const current = pool[index];
    if (Math.abs(current.amount) <= target + 0.01) {
      const res = findSubset(target - Math.abs(current.amount), pool, [...path, current], index + 1);
      if (res) return res;
    }
    return findSubset(target, pool, path, index + 1);
  };

  // Sort creditors Descending (Largest First) so Cheryl gets filled first
  creditors.sort((a, b) => b.amount - a.amount); 

  for (let j = 0; j < creditors.length; j++) {
    const cred = creditors[j];
    if (cred.amount < 0.01) continue;

    // Try to find exact matches from debtors to clear this creditor
    const subset = findSubset(cred.amount, debtors.filter(d => Math.abs(d.amount) > 0.01));
    if (subset) {
      subset.forEach(deb => addSettlement(deb, cred, Math.abs(deb.amount)));
    }
  }

  // 2. GREEDY FILL (Largest First)
  // Ensure the largest remaining creditor (likely Cheryl) grabs the largest remaining debtors (Alex, etc.)
  debtors = debtors.filter(d => Math.abs(d.amount) > 0.01).sort((a, b) => a.amount - b.amount); // Most negative first
  creditors = creditors.filter(c => c.amount > 0.01).sort((a, b) => b.amount - a.amount); // Most positive first

  let i = 0; 
  let j = 0; 

  while (i < debtors.length && j < creditors.length) {
    const debtor = debtors[i];
    const creditor = creditors[j];

    if (Math.abs(debtor.amount) < 0.01) { i++; continue; }
    if (creditor.amount < 0.01) { j++; continue; }

    const amount = Math.min(Math.abs(debtor.amount), creditor.amount);
    addSettlement(debtor, creditor, amount);
  }

  return { settlements, balances };
};

